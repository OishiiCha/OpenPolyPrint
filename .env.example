# =============================================================================
# OpenPolyPrint Environment Configuration
# =============================================================================
# Copy this file to ".env" and fill in your values. The .env file is loaded
# automatically at startup. Environment variables set in the shell or Docker
# take precedence over values in the .env file.
#
# All values are optional — the app will fall back to settings.json for
# anything not set here. Only put secrets/keys in .env; UI preferences
# (dark mode, compact mode, etc.) stay in settings.json.
# =============================================================================

# ---- Server ----
# Bind address for HTTPS (default :443)
# OPENPOLYPRINT_ADDR=:443
# Enable HTTPS with auto-generated self-signed certificate (default true)
# OPENPOLYPRINT_TLS=true
# Data directory for persistent config (default: platform config dir)
# OPENPOLYPRINT_DATA_DIR=/data

# ---- Anker Cloud (printer discovery & remote control) ----
# Get these from the Anker login flow in the Settings page, or by logging
# in to the Anker Make app and extracting the auth token.
# ANKER_EMAIL=you@example.com
# ANKER_PASSWORD=yourpassword
# ANKER_REGION=NA
# ANKER_AUTH_TOKEN=
# ANKER_USER_ID=

# ---- Gemini AI (print analysis) ----
# Get an API key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_ENABLED=false

# ---- Push Notifications (VAPID keys) ----
# Leave blank to auto-generate. Set if you want to use the same VAPID
# keys across restarts or share them with another instance.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ---- Telegram Bot ----
# Create a bot with @BotFather and get the token + your chat ID.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ---- Discord Webhook ----
# Create a webhook: Server Settings → Integrations → Webhooks → New Webhook
# DISCORD_WEBHOOK_URL=

# ---- n8n / Zapier Webhook ----
# N8N_WEBHOOK_URL=

# ---- Obico (AI print monitoring) ----
# Get the API token from your Obico dashboard.
# OBICO_TOKEN=

# ---- Smart Plugs ----
# Tasmota/SmartLife/Tuya smart plug credentials (if using per-plug auth)
# SMARTPLUG_PASSWORD=

# ---- Printer Providers (Klipper, FlashForge, etc.) ----
# Each provider can have host + API key. These override the Settings page.
# KLIPPER_HOST=
# KLIPPER_API_KEY=
# FLASHFORGE_HOST=
# FLASHFORGE_API_KEY=
