# Build stage — use Debian Bookworm for glibc compatibility with rpicam-apps
FROM golang:1.26-bookworm AS builder

WORKDIR /app

# Copy go module files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /openpolyprint ./cmd/openpolyprint

# Runtime stage — Debian Bookworm slim (same base as Raspberry Pi OS)
FROM debian:bookworm-slim

# Install runtime dependencies:
# - ca-certificates: TLS
# - ffmpeg: video encoding/transcoding
# - rpicam-apps: rpicam-vid for Pi camera module (MIPI CSI)
# - libcamera-apps: libcamera-vid fallback
# - pigpiod + python bindings for GPIO
# - Adafruit_DHT for DHT11 sensors
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    gnupg \
    wget \
    && \
    # Add Raspberry Pi APT repository
    install -m 0755 -d /etc/apt/keyrings && \
    wget -qO- https://archive.raspberrypi.com/debian/raspberrypi.gpg.key | \
    gpg --dearmor -o /etc/apt/keyrings/raspberrypi.gpg && \
    chmod a+r /etc/apt/keyrings/raspberrypi.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/raspberrypi.gpg] http://archive.raspberrypi.com/debian/ bookworm main" \
    > /etc/apt/sources.list.d/raspberrypi.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    ffmpeg \
    rpicam-apps \
    libcamera-apps \
    python3 \
    python3-dev \
    gcc \
    make \
    python3-pip \
    python3-lgpio \
    pigpiod \
    pigpio \
    && pip3 install --no-cache-dir --break-system-packages pigpio && \
    pip3 download --no-cache-dir --no-deps --no-binary :all: Adafruit_DHT -d /tmp/dht && \
    cd /tmp/dht && tar xf *.tar.gz && cd Adafruit_DHT-* && \
    python3 setup.py install --force-pi && \
    rm -rf /tmp/dht && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /openpolyprint /usr/local/bin/openpolyprint

# Entrypoint script starts pigpiod then runs openpolyprint
RUN printf '#!/bin/sh\npigpiod -l\nsleep 1\nexec "$@"\n' > /entrypoint.sh && chmod +x /entrypoint.sh

# Create data directory for recordings and gcode files (mounted as volume in docker-compose)
RUN mkdir -p /data

# Expose default web server port
EXPOSE 80

ENTRYPOINT ["/entrypoint.sh", "openpolyprint"]
CMD ["-addr", "0.0.0.0:80"]
